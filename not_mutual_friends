#Função em Python que compara duas listas de amigos e retorna os nomes que aparecem em apenas uma delas, excluindo os amigos em comum.

def not_mutual_friends(list1, list2):

    list3 = []

    for nomes in list1:
        if nomes not in list2:
            list3.append(nomes)

    for nomes in list2:
        if nomes not in list1:
            list3.append(nomes)

    print (list3)
